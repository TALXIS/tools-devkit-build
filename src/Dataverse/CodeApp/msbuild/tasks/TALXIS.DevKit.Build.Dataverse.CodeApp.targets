<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <RunNodeBuild Condition="'$(RunNodeBuild)'=='' and Exists('$(NodeRootFullPath)/package.json')">true</RunNodeBuild>
    <RunNodeBuild Condition="'$(RunNodeBuild)'==''">false</RunNodeBuild>
  </PropertyGroup>

  <Target Name="CheckCodeAppPrereqs"
    Condition="'$(RunNodeBuild)'=='true'">
    <Error Condition="!Exists('$(NodeRootFullPath)/package.json')" Text="CodeApp package.json not found in $(NodeRootFullPath)" />
    <!-- Only Node.js itself is a hard prerequisite here - which package manager binary is
         actually required depends on what NodeRestore below detects (npm/pnpm/yarn/bun/rush),
         so that check is left to NodeRestore's own Exec failing clearly if the resolved tool
         isn't on PATH, rather than hardcoding a single tool's presence here. -->
    <Exec Command="node --version" IgnoreExitCode="true" />
    <Error Condition="'$(MSBuildLastTaskResult)'!='True'" Text="Node.js not found in PATH. Install Node.js to build CodeApp." />
  </Target>

  <!-- Node dependency hydration is anchored in Sdk.NodeRestore.targets (_NodeRestoreAnchor), not here, so it
       also runs during a bare "dotnet restore". -->

  <!-- Supplies this project's arguments to the shared NodeBuild targets via DependsOnTargets, not
       CallTarget - properties set in a target reached through CallTarget are not visible inside
       the called target, only ones reached through the DependsOnTargets chain are. -->
  <Target Name="_CodeAppSetNodeBuildArgs">
    <PropertyGroup>
      <_NodeBuildProjectDirectory>$(NodeRootFullPath)</_NodeBuildProjectDirectory>
      <_NodeBuildModeArgName Condition="'$(_NodeBuildModeArgName)'==''">mode</_NodeBuildModeArgName>
      <_NodeBuildExtraArgs></_NodeBuildExtraArgs>
      <_NodeBuildRequiredRushParams></_NodeBuildRequiredRushParams>
    </PropertyGroup>
  </Target>

  <Target Name="BuildCodeApp"
    DependsOnTargets="CheckCodeAppPrereqs;_NodeRestoreResolve;_CodeAppSetNodeBuildArgs;_NodeRestoreDelegateBuildToRush;_NodeRestoreBuildDirect"
    BeforeTargets="Build"
    Condition="'$(RunNodeBuild)'=='true'">
    <Message Text="Node build for CodeApp in $(NodeRootFullPath) completed (or was already up to date)." Importance="High" />
  </Target>

  <!-- Removes this project's own JS build-output folder ("dist") on "dotnet clean". Plain
       RemoveDir, no process invocation - Clean needs no Node toolchain present at all here.
       Deliberately never touches node_modules or any shared Rush/pnpm workspace state: npm-land
       treats "clean" and "prune deps" as different operations, and node_modules removal is a far
       more expensive, disruptive step that must not be a silent side effect of every
       "dotnet clean". -->
  <Target Name="CleanCodeApp" AfterTargets="Clean" Condition="'$(RunNodeBuild)'=='true'">
    <RemoveDir Directories="$(NodeRootFullPath)/dist" Condition="Exists('$(NodeRootFullPath)/dist')" />
  </Target>

  <Target Name="CopyCodeAppDist"
    AfterTargets="Build"
    Condition="'$(RunNodeBuild)'=='true'">
    <Error Condition="'$(AppName)'==''" Text="AppName property is not set. Set it in the project file." />

    <ItemGroup>
      <CodeAppDistFiles Include="$(NodeRootFullPath)/dist/**/*.*" />
    </ItemGroup>

    <Error Condition="'@(CodeAppDistFiles)'==''" Text="No files found in $(NodeRootFullPath)/dist. Ensure npm run build produces output in the dist folder." />

    <Message Text="Copying CodeApp dist to $(OutputPath)$(AppName)/" Importance="High" />
    <Copy SourceFiles="@(CodeAppDistFiles)" DestinationFiles="@(CodeAppDistFiles->'$(OutputPath)$(AppName)/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="GetProjectType" Returns="@(_ProjectType)" Condition="'$(ProjectType)'!=''">
    <ItemGroup>
      <_ProjectType Include="$(MSBuildProjectFullPath)">
        <ProjectType>$(ProjectType)</ProjectType>
      </_ProjectType>
    </ItemGroup>
  </Target>

  <!-- CodeApp projects are consumed via <ProjectReference> from a Solution project, which builds
       and stages the app directly into the solution - they are not standalone components and
       cannot be published as a NuGet package. Only Solution and PDPackage projects produce NuGet
       packages. Hooking into BeforePack (rather than BeforeTargets="Pack") fails before any
       nuspec/nupkg work starts. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <BeforePack>$(BeforePack);_ErrorOnCodeAppPack</BeforePack>
  </PropertyGroup>
  <Target Name="_ErrorOnCodeAppPack">
    <Error Text="CodeApp projects cannot be packed as a standalone NuGet package. Reference this project from a Solution project via ProjectReference instead - only Solution and PDPackage projects produce NuGet packages." />
  </Target>

  <Target Name="GetCodeAppOutputs"
    DependsOnTargets="Build"
    Returns="@(_CodeAppOutputs)">
    <ItemGroup>
      <_CodeAppOutputs Include="$(NodeRootFullPath)/dist">
        <AppName>$(AppName)</AppName>
        <ConfigPath>$(NodeRootFullPath)/power.config.json</ConfigPath>
      </_CodeAppOutputs>
    </ItemGroup>
  </Target>

  <Target Name="CopyCodeAppDistPublish"
    AfterTargets="Publish"
    Condition="'$(RunNodeBuild)'=='true'">
    <Error Condition="'$(AppName)'==''" Text="AppName property is not set. Set it in the project file." />

    <ItemGroup>
      <CodeAppDistPublishFiles Include="$(NodeRootFullPath)/dist/**/*.*" />
    </ItemGroup>

    <Error Condition="'@(CodeAppDistPublishFiles)'==''" Text="No files found in $(NodeRootFullPath)/dist. Ensure npm run build produces output in the dist folder." />

    <Message Text="Copying CodeApp dist to $(PublishDir)$(AppName)/" Importance="High" />
    <Copy SourceFiles="@(CodeAppDistPublishFiles)" DestinationFiles="@(CodeAppDistPublishFiles->'$(PublishDir)$(AppName)/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
