<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <RunNodeBuild Condition="'$(RunNodeBuild)'=='' and Exists('$(NodeRootFullPath)/package.json')">true</RunNodeBuild>
    <RunNodeBuild Condition="'$(RunNodeBuild)'==''">false</RunNodeBuild>
  </PropertyGroup>

  <Target Name="CheckCodeAppPrereqs"
    Condition="'$(RunNodeBuild)'=='true'">
    <Error Condition="!Exists('$(NodeRootFullPath)/package.json')" Text="CodeApp package.json not found in $(NodeRootFullPath)" />
  </Target>

  <!-- Node dependency hydration is anchored in Sdk.NodeRestore.targets (_NodeRestoreAnchor), not here, so it
       also runs during a bare "dotnet restore". NodeRestore additionally sits in the build
       target chain below as a safety net: a solution-scope restore on a cold NuGet cache
       cannot hydrate Node deps (NuGet never runs a per-project Restore target there), so the
       build hydrates them itself - a no-op via the restore stamp when already hydrated. -->

  <!-- Supplies this project's arguments to the shared NodeBuild targets via DependsOnTargets, not
       CallTarget - properties set in a target reached through CallTarget are not visible inside
       the called target, only ones reached through the DependsOnTargets chain are. -->
  <Target Name="_CodeAppSetNodeBuildArgs">
    <ItemGroup>
      <NodeBuildArgument Include="--mode">
        <Value>$(NodeBuildConfiguration)</Value>
      </NodeBuildArgument>
    </ItemGroup>
  </Target>

  <Target Name="BuildCodeApp"
    DependsOnTargets="CheckCodeAppPrereqs;NodeRestore;_CodeAppSetNodeBuildArgs;NodeBuild"
    BeforeTargets="Build"
    Condition="'$(RunNodeBuild)'=='true'">
    <Message Text="Node build for CodeApp in $(NodeRootFullPath) completed (or was already up to date)." Importance="High" />
  </Target>

  <!-- Removes this project's own JS build-output folder ("dist") on "dotnet clean". Plain
       RemoveDir, no process invocation - Clean needs no Node toolchain present at all here.
       Deliberately never touches node_modules or any shared Rush/pnpm workspace state: npm-land
       treats "clean" and "prune deps" as different operations, and node_modules removal is a far
       more expensive, disruptive step that must not be a silent side effect of every
       "dotnet clean". -->
  <Target Name="CleanCodeApp" AfterTargets="Clean" Condition="'$(RunNodeBuild)'=='true'" DependsOnTargets="_NodeBuildResolveOutputDir">
    <RemoveDir Directories="$(NodeBuildOutputDir);$(NodeRootFullPath)/dist;$(OutDir)$(AppName)" />
  </Target>

  <!-- The deliverable is the folder $(OutDir)$(AppName)/, which Solution projects pick up through
       GetCodeAppOutputs. The build is expected to write the app to BUILD_OUTPUT_DIR
       ($(NodeBuildOutputDir)); a build that ignores it (for example Vite's default dist/) is
       picked up from dist/ under the Node root. The deliverable folder is emptied first, so
       hashed asset files from earlier builds are never packaged. -->
  <Target Name="CopyCodeAppDist"
    AfterTargets="Build"
    DependsOnTargets="_NodeBuildResolveOutputDir"
    Condition="'$(RunNodeBuild)'=='true'">
    <Error Condition="'$(AppName)'==''" Text="AppName property is not set. Set it in the project file." />

    <PropertyGroup>
      <_CodeAppDeliverableDir>$(OutDir)$(AppName)/</_CodeAppDeliverableDir>
      <_CodeAppBuiltDir Condition="Exists('$(NodeBuildOutputDir)index.html')">$(NodeBuildOutputDir)</_CodeAppBuiltDir>
      <_CodeAppBuiltDir Condition="'$(_CodeAppBuiltDir)' == '' and Exists('$(NodeRootFullPath)/dist/index.html')">$(NodeRootFullPath)/dist/</_CodeAppBuiltDir>
    </PropertyGroup>
    <Error Condition="'$(_CodeAppBuiltDir)' == ''"
           Text="CodeApp: the Node build did not produce index.html. Looked in $(NodeBuildOutputDir) (BUILD_OUTPUT_DIR) and $(NodeRootFullPath)/dist. Make the build write the app to BUILD_OUTPUT_DIR." />

    <ItemGroup>
      <_CodeAppBuiltFiles Include="$(_CodeAppBuiltDir)**/*.*" />
    </ItemGroup>
    <RemoveDir Directories="$(_CodeAppDeliverableDir)" />
    <Message Text="CodeApp: $(_CodeAppBuiltDir) -> $(_CodeAppDeliverableDir)" Importance="High" />
    <Copy SourceFiles="@(_CodeAppBuiltFiles)" DestinationFiles="@(_CodeAppBuiltFiles->'$(_CodeAppDeliverableDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <ItemGroup>
      <NodeBuildOutputFile Include="$(_CodeAppDeliverableDir)**/*.js" />
    </ItemGroup>
  </Target>

  <Target Name="_CodeAppCheckOutput"
    AfterTargets="CopyCodeAppDist"
    DependsOnTargets="_NodeBuildCheckOutput" />

  <Target Name="GetProjectType" Returns="@(_ProjectType)" Condition="'$(ProjectType)'!=''">
    <ItemGroup>
      <_ProjectType Include="$(MSBuildProjectFullPath)">
        <ProjectType>$(ProjectType)</ProjectType>
      </_ProjectType>
    </ItemGroup>
  </Target>

  <!-- CodeApp projects are consumed via <ProjectReference> from a Solution project, which builds
       and stages the app directly into the solution - they are not standalone components and
       cannot be published as a NuGet package. Only Solution and PDPackage projects produce NuGet
       packages. Hooking into BeforePack (rather than BeforeTargets="Pack") fails before any
       nuspec/nupkg work starts. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <BeforePack>$(BeforePack);_ErrorOnCodeAppPack</BeforePack>
  </PropertyGroup>
  <Target Name="_ErrorOnCodeAppPack">
    <Error Text="CodeApp projects cannot be packed as a standalone NuGet package. Reference this project from a Solution project via ProjectReference instead - only Solution and PDPackage projects produce NuGet packages." />
  </Target>

  <Target Name="GetCodeAppOutputs"
    DependsOnTargets="Build"
    Returns="@(_CodeAppOutputs)">
    <ItemGroup>
      <_CodeAppOutputs Include="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(OutDir)', '$(AppName)'))">
        <AppName>$(AppName)</AppName>
        <ConfigPath>$(NodeRootFullPath)/power.config.json</ConfigPath>
      </_CodeAppOutputs>
    </ItemGroup>
  </Target>

  <Target Name="CopyCodeAppDistPublish"
    AfterTargets="Publish"
    Condition="'$(RunNodeBuild)'=='true'">
    <ItemGroup>
      <_CodeAppPublishFiles Include="$(OutDir)$(AppName)/**/*.*" />
    </ItemGroup>
    <RemoveDir Directories="$(PublishDir)$(AppName)" />
    <Message Text="CodeApp: $(OutDir)$(AppName)/ -> $(PublishDir)$(AppName)/" Importance="High" />
    <Copy SourceFiles="@(_CodeAppPublishFiles)" DestinationFiles="@(_CodeAppPublishFiles->'$(PublishDir)$(AppName)/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
