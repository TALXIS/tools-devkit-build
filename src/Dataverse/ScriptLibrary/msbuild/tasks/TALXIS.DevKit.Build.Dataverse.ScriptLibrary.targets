<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <RunNodeBuild Condition="'$(RunNodeBuild)'=='' and Exists('$(NodeRootFullPath)/package.json')">true</RunNodeBuild>
    <RunNodeBuild Condition="'$(RunNodeBuild)'==''">false</RunNodeBuild>
  </PropertyGroup>

  <!-- Node dependency hydration is anchored in Sdk.NodeRestore.targets (_NodeRestoreAnchor), not here, so it
       also runs during a bare "dotnet restore". NodeRestore additionally sits in the build
       target chain below as a safety net: a solution-scope restore on a cold NuGet cache
       cannot hydrate Node deps (NuGet never runs a per-project Restore target there), so the
       build hydrates them itself - a no-op via the restore stamp when already hydrated. -->

  <Target Name="BuildTypeScript"
    DependsOnTargets="CheckScriptLibraryPrereqs;NodeRestore;NodeBuild"
    BeforeTargets="Build"
    Condition="'$(RunNodeBuild)'=='true'">
    <Message Text="Node build for ScriptLibrary in $(NodeRootFullPath) completed (or was already up to date)." Importance="High" />
  </Target>

  <!-- Removes this project's own JS build-output folder on "dotnet clean". Plain RemoveDir, no
       process invocation - Clean needs no Node toolchain present at all here. Deliberately never
       touches node_modules or any shared Rush/pnpm workspace state: npm-land treats "clean" and
       "prune deps" as different operations, and node_modules removal is a far more expensive,
       disruptive step that must not be a silent side effect of every "dotnet clean". -->
  <Target Name="CleanScriptLibrary" AfterTargets="Clean" Condition="'$(RunNodeBuild)'=='true'" DependsOnTargets="_NodeBuildResolveOutputDir">
    <RemoveDir Directories="$(NodeBuildOutputDir);$(NodeRootFullPath)/build" />
  </Target>
  
  <Target Name="CheckScriptLibraryPrereqs"
    Condition="'$(RunNodeBuild)'=='true'">
    <Error Condition="!Exists('$(NodeRootFullPath)')" Text="ScriptLibrary Node root directory not found: $(NodeRootFullPath)" />
    <Error Condition="!Exists('$(NodeRootFullPath)/package.json')" Text="ScriptLibrary package.json not found in $(NodeRootFullPath)" />
  </Target>

  <Target Name="GetProjectType" Returns="@(_ProjectType)" Condition="'$(ProjectType)'!=''">
    <ItemGroup>
      <_ProjectType Include="$(MSBuildProjectFullPath)">
        <ProjectType>$(ProjectType)</ProjectType>
      </_ProjectType>
    </ItemGroup>
  </Target>

  <Target Name="GetScriptLibraryOutputs"
    DependsOnTargets="Build"
    Returns="@(_ScriptLibraryOutputs)">
    <ItemGroup>
      <_ScriptLibraryOutputs Include="$(TargetDir)$(ScriptLibraryName).js" />
    </ItemGroup>
  </Target>

  <!-- The deliverable is $(TargetDir)$(ScriptLibraryName).js, the file Solution projects pick up
       through GetScriptLibraryOutputs. A Node build is expected to write it to BUILD_OUTPUT_DIR
       ($(NodeBuildOutputDir)); for build scripts that ignore it, the tool's own dist/ and build/
       folders under the Node root are checked next. Without a Node build (no package.json) the
       library ships a checked-in file, found anywhere under the Node root as before. -->
  <Target Name="CopyScriptLibraryMainToOutput"
    AfterTargets="Build"
    DependsOnTargets="_NodeBuildResolveOutputDir">
    <PropertyGroup>
      <_ScriptLibraryDeliverable>$(TargetDir)$(ScriptLibraryName).js</_ScriptLibraryDeliverable>
      <_ScriptLibraryBuiltFile Condition="'$(RunNodeBuild)' == 'true' and Exists('$(NodeBuildOutputDir)$(ScriptLibraryName).js')">$(NodeBuildOutputDir)$(ScriptLibraryName).js</_ScriptLibraryBuiltFile>
      <_ScriptLibraryBuiltFile Condition="'$(RunNodeBuild)' == 'true' and '$(_ScriptLibraryBuiltFile)' == '' and Exists('$(NodeRootFullPath)/dist/$(ScriptLibraryName).js')">$(NodeRootFullPath)/dist/$(ScriptLibraryName).js</_ScriptLibraryBuiltFile>
      <_ScriptLibraryBuiltFile Condition="'$(RunNodeBuild)' == 'true' and '$(_ScriptLibraryBuiltFile)' == '' and Exists('$(NodeRootFullPath)/build/$(ScriptLibraryName).js')">$(NodeRootFullPath)/build/$(ScriptLibraryName).js</_ScriptLibraryBuiltFile>
    </PropertyGroup>
    <Error Condition="'$(RunNodeBuild)' == 'true' and '$(_ScriptLibraryBuiltFile)' == ''"
           Text="ScriptLibrary: the Node build did not produce $(ScriptLibraryName).js. Looked in $(NodeBuildOutputDir) (BUILD_OUTPUT_DIR), $(NodeRootFullPath)/dist and $(NodeRootFullPath)/build. Make the build write $(ScriptLibraryName).js to BUILD_OUTPUT_DIR, or set ScriptLibraryName to the file it writes." />

    <ItemGroup Condition="'$(RunNodeBuild)' != 'true'">
      <_ScriptLibraryCheckedInFile Include="$(NodeRootFullPath)/**/$(ScriptLibraryName).js"
                                   Exclude="$(NodeRootFullPath)/node_modules/**;$(NodeRootFullPath)/bin/**;$(NodeRootFullPath)/obj/**" />
    </ItemGroup>
    <PropertyGroup Condition="'$(RunNodeBuild)' != 'true'">
      <_ScriptLibraryBuiltFile>@(_ScriptLibraryCheckedInFile)</_ScriptLibraryBuiltFile>
    </PropertyGroup>

    <Message Text="ScriptLibrary: $(_ScriptLibraryBuiltFile) -> $(_ScriptLibraryDeliverable)" Importance="High" Condition="'$(_ScriptLibraryBuiltFile)' != ''" />
    <Copy SourceFiles="$(_ScriptLibraryBuiltFile)" DestinationFiles="$(_ScriptLibraryDeliverable)" SkipUnchangedFiles="true" Condition="'$(_ScriptLibraryBuiltFile)' != ''" />
    <ItemGroup Condition="'$(RunNodeBuild)' == 'true'">
      <NodeBuildOutputFile Include="$(_ScriptLibraryDeliverable)" />
    </ItemGroup>
  </Target>

  <Target Name="_ScriptLibraryCheckOutput"
    AfterTargets="CopyScriptLibraryMainToOutput"
    DependsOnTargets="_NodeBuildCheckOutput" />

  <!--
    A ScriptLibrary project can opt into one of two relationships with each
    of its ProjectReference entries to another ScriptLibrary project:

      Separate     (default) both deploy as own web resources
      CompileOnly  the referenced project still builds (so its .d.ts is
                   available for /// <reference> in our TS), but its .js
                   is not deployed by the Solution that consumes us

    The Solution package reads GetSuppressedScriptLibraryReferences below
    to learn which references must NOT be deployed as their own web
    resources.
  -->

  <Target Name="GetSuppressedScriptLibraryReferences"
          Returns="@(_SuppressedScriptLibraryReferences)">
    <ItemGroup>
      <_SuppressedScriptLibraryReferences
          Include="@(ProjectReference->'%(FullPath)')"
          Condition="'%(ProjectReference.ScriptLibraryMode)' == 'CompileOnly'" />
    </ItemGroup>
  </Target>

</Project>
