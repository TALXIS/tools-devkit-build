<Project>
  <!-- Builds the Node project through the orchestrator or package manager resolved by
       NodeToolchain. Project types add public NodeBuildArgument items before invoking NodeBuild.
       Built-in and external providers hook this public target and consume selected items. -->
  <PropertyGroup>
    <NodeBuildConfiguration Condition="'$(NodeBuildConfiguration)' == '' and '$(Configuration)' == 'Release'">production</NodeBuildConfiguration>
    <NodeBuildConfiguration Condition="'$(NodeBuildConfiguration)' == ''">development</NodeBuildConfiguration>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)NodeBuild\Npm.targets" />
  <Import Project="$(MSBuildThisFileDirectory)NodeBuild\Pnpm.targets" />
  <Import Project="$(MSBuildThisFileDirectory)NodeBuild\Yarn.targets" />
  <Import Project="$(MSBuildThisFileDirectory)NodeBuild\Bun.targets" />
  <Import Project="$(MSBuildThisFileDirectory)NodeBuild\Rush.targets" />

  <Target Name="NodeBuild" DependsOnTargets="NodeToolchain" />
</Project>
