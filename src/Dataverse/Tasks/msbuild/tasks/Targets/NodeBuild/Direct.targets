<Project>
  <Target Name="_NodeBuildDirect"
          AfterTargets="NodeBuild"
          Condition="'$(_NodeOrchestratorOwnsBuild)' != 'true' and '$(_NodePackageManager)' != ''">
    <PropertyGroup>
      <_NodeBuildDirectCommand Condition="'$(_NodePackageManager)' == 'pnpm'">pnpm run build --</_NodeBuildDirectCommand>
      <_NodeBuildDirectCommand Condition="'$(_NodePackageManager)' == 'yarn'">yarn run build</_NodeBuildDirectCommand>
      <_NodeBuildDirectCommand Condition="'$(_NodePackageManager)' == 'bun'">bun run build</_NodeBuildDirectCommand>
      <_NodeBuildDirectCommand Condition="'$(_NodeBuildDirectCommand)' == ''">npm run build --</_NodeBuildDirectCommand>
      <_NodeBuildModeArgs Condition="'$(_NodeBuildModeArgName)' != ''">--$(_NodeBuildModeArgName) $(NodeBuildConfiguration)</_NodeBuildModeArgs>
    </PropertyGroup>
    <Exec WorkingDirectory="$(_NodeBuildProjectDirectory)"
          Command="$(_NodeBuildDirectCommand) $(_NodeBuildModeArgs) $(_NodeBuildExtraArgs)"
          EnvironmentVariables="NODE_ENV=$(NodeBuildConfiguration)" />
  </Target>
</Project>
