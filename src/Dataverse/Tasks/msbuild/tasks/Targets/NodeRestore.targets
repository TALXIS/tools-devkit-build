<Project>
  <!--
    Hydrates Node dependencies through the package manager or orchestrator resolved by
    NodeToolchain. Tool-specific targets hook AfterTargets="NodeRestore"; external NuGet
    extensions use the same mechanism.

    Properties:
      NodeRootPath        Relative path to the Node project root. Default: project directory.
      NodePackageManager  '' (auto) | None | npm | pnpm | yarn | bun.
                          None skips dependency hydration.
      NodeOrchestrator    '' (auto) | None | rush.
      NodeRestoreCommand  Exact command override. Tool-specific restore targets do not run.
  -->
  <Import Project="$(MSBuildThisFileDirectory)NodeRestore\Rush.targets" />
  <Import Project="$(MSBuildThisFileDirectory)NodeRestore\CustomCommand.targets" />
  <Import Project="$(MSBuildThisFileDirectory)NodeRestore\Npm.targets" />
  <Import Project="$(MSBuildThisFileDirectory)NodeRestore\Pnpm.targets" />
  <Import Project="$(MSBuildThisFileDirectory)NodeRestore\Yarn.targets" />
  <Import Project="$(MSBuildThisFileDirectory)NodeRestore\Bun.targets" />
  <Import Project="$(MSBuildThisFileDirectory)NodeRestore\Retry.targets" />

  <Target Name="NodeRestore"
          DependsOnTargets="_NodeToolchainResolve"
          Condition="'$(NodePackageManager)' != 'None'" />
</Project>
