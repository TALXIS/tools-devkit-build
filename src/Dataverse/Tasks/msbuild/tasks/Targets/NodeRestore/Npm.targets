<Project>
  <Target Name="_NodeRestoreNpmResolve"
          Condition="'$(NodeRestoreCommand)' == '' and '$(_NodeOrchestratorOwnsRestore)' != 'true' and '$(_NodePackageManager)' == 'npm'">
    <PropertyGroup>
      <_NodeRestoreHasLockfile Condition="Exists('$(_NodePackageManagerRootPath)/package-lock.json')">true</_NodeRestoreHasLockfile>
      <_NodeRestoreUseFrozen Condition="'$(IsRunningInCI)' == 'true' and '$(_NodeRestoreHasLockfile)' == 'true'">true</_NodeRestoreUseFrozen>
      <_NodeRestorePackageJsonPath>$(NodeRootFullPath)/package.json</_NodeRestorePackageJsonPath>
      <_NodeRestoreLockfilePath Condition="'$(_NodeRestoreHasLockfile)' == 'true'">$(_NodePackageManagerRootPath)/package-lock.json</_NodeRestoreLockfilePath>
      <_NodeRestoreIncrementalInputs>$(_NodeRestorePackageJsonPath)</_NodeRestoreIncrementalInputs>
      <_NodeRestoreIncrementalInputs Condition="'$(_NodeRestoreHasLockfile)' == 'true'">$(_NodeRestorePackageJsonPath);$(_NodeRestoreLockfilePath)</_NodeRestoreIncrementalInputs>
      <_NodeRestoreStampPath>$(_NodePackageManagerRootPath)/node_modules/.node-restore.stamp</_NodeRestoreStampPath>
      <_NodeRestoreResolvedCommand Condition="'$(_NodeRestoreUseFrozen)' == 'true'">npm ci</_NodeRestoreResolvedCommand>
      <_NodeRestoreResolvedCommand Condition="'$(_NodeRestoreResolvedCommand)' == ''">npm install</_NodeRestoreResolvedCommand>
    </PropertyGroup>

    <Warning Condition="'$(IsRunningInCI)' == 'true' and '$(_NodeRestoreHasLockfile)' != 'true'"
             Text="NodeRestore: no package-lock.json was found at '$(_NodePackageManagerRootPath)'; using 'npm install' instead of 'npm ci'." />
  </Target>

  <Target Name="_NodeRestoreNpmRun"
          AfterTargets="NodeRestore"
          DependsOnTargets="_NodeRestoreNpmResolve"
          Condition="'$(NodeRestoreCommand)' == '' and '$(_NodeOrchestratorOwnsRestore)' != 'true' and '$(_NodePackageManager)' == 'npm'"
          Inputs="$(_NodeRestoreIncrementalInputs)"
          Outputs="$(_NodeRestoreStampPath)">
    <Exec Command="$(_NodeRestoreResolvedCommand)"
          WorkingDirectory="$(_NodePackageManagerRootPath)"
          StandardOutputImportance="Low"
          StandardErrorImportance="High" />
    <MakeDir Directories="$(_NodePackageManagerRootPath)/node_modules" />
    <Touch Files="$(_NodeRestoreStampPath)" AlwaysCreate="true" />
  </Target>
</Project>
