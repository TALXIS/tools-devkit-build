<Project>
  <Target Name="_NodeRestorePnpmResolve"
          Condition="'$(NodeRestoreCommand)' == '' and '$(_NodeOrchestratorOwnsRestore)' != 'true' and '$(_NodePackageManager)' == 'pnpm'">
    <PropertyGroup>
      <_NodeRestoreHasLockfile Condition="Exists('$(_NodePackageManagerRootPath)/pnpm-lock.yaml')">true</_NodeRestoreHasLockfile>
      <_NodeRestoreUseFrozen Condition="'$(IsRunningInCI)' == 'true' and '$(_NodeRestoreHasLockfile)' == 'true'">true</_NodeRestoreUseFrozen>
      <_NodeRestorePackageJsonPath>$(NodeRootFullPath)/package.json</_NodeRestorePackageJsonPath>
      <_NodeRestoreLockfilePath Condition="'$(_NodeRestoreHasLockfile)' == 'true'">$(_NodePackageManagerRootPath)/pnpm-lock.yaml</_NodeRestoreLockfilePath>
      <_NodeRestoreIncrementalInputs>$(_NodeRestorePackageJsonPath)</_NodeRestoreIncrementalInputs>
      <_NodeRestoreIncrementalInputs Condition="'$(_NodeRestoreHasLockfile)' == 'true'">$(_NodeRestorePackageJsonPath);$(_NodeRestoreLockfilePath)</_NodeRestoreIncrementalInputs>
      <_NodeRestoreStampPath>$(_NodePackageManagerRootPath)/node_modules/.node-restore.stamp</_NodeRestoreStampPath>
      <_NodeRestoreResolvedCommand Condition="'$(_NodeRestoreUseFrozen)' == 'true'">pnpm install --frozen-lockfile</_NodeRestoreResolvedCommand>
      <_NodeRestoreResolvedCommand Condition="'$(_NodeRestoreResolvedCommand)' == ''">pnpm install</_NodeRestoreResolvedCommand>
    </PropertyGroup>
  </Target>

  <Target Name="_NodeRestorePnpmRun"
          AfterTargets="NodeRestore"
          DependsOnTargets="_NodeRestorePnpmResolve"
          Condition="'$(NodeRestoreCommand)' == '' and '$(_NodeOrchestratorOwnsRestore)' != 'true' and '$(_NodePackageManager)' == 'pnpm'"
          Inputs="$(_NodeRestoreIncrementalInputs)"
          Outputs="$(_NodeRestoreStampPath)">
    <Exec Command="$(_NodeRestoreResolvedCommand)"
          WorkingDirectory="$(_NodePackageManagerRootPath)"
          StandardOutputImportance="Low"
          StandardErrorImportance="High" />
    <MakeDir Directories="$(_NodePackageManagerRootPath)/node_modules" />
    <Touch Files="$(_NodeRestoreStampPath)" AlwaysCreate="true" />
  </Target>
</Project>
