<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <Target Name="GetProjectOutputPath" Returns="@(_ProjectOutputPath)" />
  <PropertyGroup>
    <!-- Default target framework. Consumers can override by setting <TargetFramework> in their csproj. -->
    <TargetFramework Condition="'$(TargetFramework)' == '' and '$(TargetFrameworks)' == ''">net472</TargetFramework>
    <TALXISDevKitDataversePackageBase Condition="'$(TALXISDevKitDataversePackageBase)' == ''">TALXIS.DevKit.Build.Dataverse</TALXISDevKitDataversePackageBase>

    <!-- Resolve SDK version from NuGet cache path: .../{id}/{version}/Sdk/Sdk.props -->
    <_TALXISDevKitBuildSdkDir>$([System.IO.Path]::GetDirectoryName($(MSBuildThisFileDirectory.TrimEnd('\/'))))</_TALXISDevKitBuildSdkDir>
    <TALXISDevKitDataversePackageVersion Condition="'$(TALXISDevKitDataversePackageVersion)' == ''">$([System.IO.Path]::GetFileName($(_TALXISDevKitBuildSdkDir)))</TALXISDevKitDataversePackageVersion>

    <!-- Two levels up from .../talxis.devkit.build.sdk/{version} is the NuGet package cache
         root itself. Derived from this file's own resolved location rather than
         $(NuGetPackageRoot): that property is not reliably populated in every MSBuild
         evaluation context restore uses internally, but MSBuildThisFileDirectory always is. -->
    <_TALXISDevKitNuGetPackageRoot>$([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName($(_TALXISDevKitBuildSdkDir)))))/</_TALXISDevKitNuGetPackageRoot>
  </PropertyGroup>

  <!-- Project types that run a Node build. The restore-time anchor in Sdk.NodeRestore.targets
       uses it before the Tasks package is on disk; the Tasks package's ProjectPaths.props has the
       same default for PackageReference consumers. A project-type package that adds a Node-based
       type adds its name here. -->
  <PropertyGroup>
    <NodeProjectTypes Condition="'$(NodeProjectTypes)' == ''">Pcf;ScriptLibrary;CodeApp</NodeProjectTypes>
  </PropertyGroup>

  <!-- Git versioning: enabled by default when using the SDK.
       Set GitVersionNumber=false in your project to opt out. -->
  <PropertyGroup>
    <GitVersionNumber Condition="'$(GitVersionNumber)' == ''">true</GitVersionNumber>
  </PropertyGroup>
</Project>
