<?xml version="1.0" encoding="utf-8"?>
<!-- Used by the fixture projects (tests/run.sh): the SDK under test is packed into tests/.feed as
     version 0.0.0-local and resolved from there; everything else comes from nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="devkit-local" value="../.feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="devkit-local">
      <package pattern="TALXIS.DevKit.Build.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
