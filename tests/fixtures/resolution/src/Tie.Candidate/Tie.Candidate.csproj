<Project Sdk="TALXIS.DevKit.Build.Sdk/0.0.0-local">
  <PropertyGroup>
    <ProjectType>ScriptLibrary</ProjectType>
    <NodePackageManagerDetectDependsOn>$(NodePackageManagerDetectDependsOn);_FixtureTie</NodePackageManagerDetectDependsOn>
  </PropertyGroup>
  <Target Name="_FixtureTie">
    <ItemGroup>
      <NodePackageManagerCandidate Include="contoso">
        <Priority>0</Priority>
        <RootPath>$(MSBuildProjectDirectory)</RootPath>
        <Source>$(MSBuildThisFileFullPath)</Source>
      </NodePackageManagerCandidate>
    </ItemGroup>
  </Target>
</Project>
